# PostgreSQL usado por Docker Compose
POSTGRES_DB=gym_planner
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password
POSTGRES_PORT=5432

# Backend
DB_URL=jdbc:postgresql://localhost:5432/gym_planner
DB_USERNAME=gym_user
DB_PASSWORD=gym_password
JWT_SECRET=change-this-to-a-random-string-of-at-least-32-chars-please
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
